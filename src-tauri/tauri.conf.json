{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grapes Album",
  "version": "0.1.0",
  "identifier": "com.grapes.photos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "葡萄相簿",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#17141d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Local-first photo workspace",
    "longDescription": "Grapes Album keeps photos in their real folders while stable workspace identities survive moves and renames.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
